<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pembinaan Diri</title>

    <link rel="stylesheet" href="/materi_diri.css">
</head>

<body>

    <div class="background"></div>

    <div class="user-info">
        👤 <%= user.username %>
    </div>

    <audio id="bgm" autoplay loop>
        <source src="/audio/backsound.mp3" type="audio/mpeg">
    </audio>

    <script src="/js/audioManager.js"></script>

    <main class="container">
        <div class="content">

            <!-- NAV -->
            <button class="nav prev" onclick="prevSlide()">
                <img src="/prevv.png" alt="Previous">
            </button>

            <button class="nav next" onclick="nextSlide()">
                <img src="/nextt.png" alt="Next">
            </button>

            <!-- SLIDE 1 -->
            <section class="slide active">
                <div class="inner-card full">

                    <div class="header-card">
                        <div class="slide-header">
                            <h2>Pembinaan Diri</h2>
                        </div>
                    </div>

                    <p>
                        Materi pembinaan diri remaja bertujuan membangun karakter positif,
                        konsep diri yang sehat, dan keterampilan hidup untuk menghadapi masa transisi.
                    </p>

                </div>
            </section>

            <!-- SLIDE 2 -->
            <section class="slide">
                <div class="inner-card full">

                    <div class="header-card">
                        <div class="slide-header">
                            <h2>Masa Remaja</h2>
                        </div>
                    </div>

                    <p>
                        Masa remaja adalah tahap penting dalam menemukan identitas diri,
                        tujuan hidup, dan bagaimana ingin dikenal oleh orang lain.
                    </p>

                </div>
            </section>

            <!-- SLIDE 3 -->
            <section class="slide">
                <div class="inner-card full">

                    <div class="header-card">
                        <div class="slide-header">
                            <h2>Mengenali Potensi</h2>
                        </div>
                    </div>

                    <p>
                        Remaja perlu mengenali kelebihan, minat, bakat, dan kekuatan karakter
                        agar mampu berkembang secara maksimal.
                    </p>

                </div>
            </section>

            <!-- SLIDE 4 -->
            <section class="slide">
                <div class="inner-card full">

                    <div class="header-card">
                        <div class="slide-header">
                            <h2>Pentingnya Pembinaan</h2>
                        </div>
                    </div>

                    <p>
                        Pembinaan diri membantu remaja mengambil keputusan yang tepat,
                        memilih pergaulan sehat, dan menjauhi perilaku negatif.
                    </p>

                </div>
            </section>

            <!-- SLIDE 5 -->
            <section class="slide">
                <div class="inner-card full">

                    <div class="header-card">
                        <div class="slide-header">
                            <h2>Adab terhadap Diri</h2>
                        </div>
                    </div>

                    <p>
                        Islam mengatur perilaku manusia terhadap dirinya sendiri.
                        Diantara perilaku/adab tersebut yaitu:
                    </p>

                </div>
            </section>

            <!-- SLIDE 6 -->
            <section class="slide">
                <div class="inner-card full">

                    <div class="header-card">
                        <div class="slide-header">
                            <img src="/Materi/diri/muhasabah.png">
                            <h2>Muhasabah</h2>
                        </div>
                    </div>

                    <p>
                        Mengakui dan merenungi setiap dosa atau kesalahan yang dilakukannya,
                        sebagai bentuk introspeksi diri untuk menjadi pribadi yang lebih baik.
                    </p>

                </div>
            </section>

            <!-- SLIDE 7 -->
            <section class="slide">
                <div class="inner-card full">

                    <div class="header-card">
                        <div class="slide-header">
                            <img src="/Materi/diri/bertaubat.png">
                            <h2>Taubat</h2>
                        </div>
                    </div>

                    <p>
                        Bertaubat kepada Allah dengan sungguh-sungguh serta berjanji
                        tidak mengulangi kesalahan yang telah diperbuat.
                    </p>

                </div>
            </section>

            <!-- SLIDE 8 -->
            <section class="slide">
                <div class="inner-card full">

                    <div class="header-card">
                        <div class="slide-header">
                            <img src="/Materi/diri/muraqabah.png">
                            <h2>Muroqobah</h2>
                        </div>
                    </div>

                    <p>
                        Merasa selalu diawasi oleh Allah, baik di tengah keramaian
                        maupun saat sendiri, sehingga menjaga diri dari perbuatan maksiat.
                    </p>

                </div>
            </section>

            <!-- SLIDE 9 -->
            <section class="slide">
                <div class="inner-card full">

                    <div class="header-card">
                        <div class="slide-header">
                            <img src="/Materi/diri/mujahadah.png">
                            <h2>Mujahadah</h2>
                        </div>
                    </div>

                    <p>
                        Bersungguh-sungguh dalam beramal sholih, belajar, dan melakukan
                        kebaikan demi meraih ridha dan pahala dari Allah.
                    </p>

                </div>
            </section>

            <!-- SLIDE 10 -->
            <section class="slide active">
                <div class="inner-card full">
                    <p>
                        Video ini berisi tentang pentingnya pembinaan diri bagi remaja dalam membentuk karakter yang
                        baik di masa transisi. Yuk mari kita tonton👇!
                    </p>

                    <!-- VIDEO TAMBAHAN -->
                    <iframe width="100%" height="400" src="https://www.youtube.com/embed/eceAdxsn7w4" frameborder="0"
                        allowfullscreen>
                    </iframe>

                </div>
            </section>

        </div>
    </main>

    <!-- BACK BUTTON -->
    <div class="back-icon">
        <a href="/materi">
            <img src="/back.png" alt="Kembali">
        </a>
    </div>

    <!-- SCRIPT -->
    <script>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');

        function showSlide(index) {
            slides.forEach(slide => slide.classList.remove('active'));
            slides[index].classList.add('active');
        }

        function nextSlide() {
            if (currentSlide < slides.length - 1) {
                currentSlide++;
                showSlide(currentSlide);
            }
        }

        function prevSlide() {
            if (currentSlide > 0) {
                currentSlide--;
                showSlide(currentSlide);
            }
        }

        showSlide(currentSlide);

    </script>

</body>

</html>